PORT=8080
TELEGRAM_TOKEN=your_telegram_bot_token
HOST=http://localhost:8080
DEBUG=true
LOG_LEVEL=debug
CALC_ENGINE=native
# Файл SQLite для сохранённых расчётов Mini App; без него история отключена.
# DB_PATH=pacer.db
# Метрики Prometheus на отдельном порту; без адреса листенер не поднимается.
# METRICS_ADDR=:9100
# Bearer-токен, который присылает коллектор Krill; пустой — все запросы получают 401.
# KRILL_METRICS_TOKEN=change_me
